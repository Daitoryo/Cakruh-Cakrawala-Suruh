@startuml
actor Mahasiswa
participant "UI Aplikasi" as UI
participant "Modul Payment" as Payment
participant "Modul Notification" as Notif

Mahasiswa -> UI : Pilih metode bayar (contoh: QRIS) & konfirmasi
activate UI
UI -> Payment : prosesPembayaran(id_pesanan, metode, nominal)
activate Payment

alt Pembayaran Valid / Saldo Cukup
    Payment --> UI : Status: "Pembayaran Sukses"
    Payment -> Notif : kirimNotifPembayaran(sukses)
    activate Notif
    Notif --> Payment : status_terkirim
    deactivate Notif
    UI --> Mahasiswa : Tampilkan struk digital & status selesai
else Pembayaran Gagal / Saldo Kurang
    Payment --> UI : Status: "Pembayaran Gagal"
    UI --> Mahasiswa : Tampilkan pesan "Saldo tidak mencukupi, pilih metode lain (misal: Cash)"
end

deactivate Payment
deactivate UI
@enduml
