@startuml
left to right direction
skinparam packageStyle rectangle

actor Mahasiswa
actor "Petugas Cakruh" as Petugas
actor Admin

package "Aplikasi Cakruh" {
  
  package "Modul Registration" {
    usecase "Mendaftar Akun" as UC1
    usecase "Verifikasi OTP" as UC2
    usecase "Mengatur Profil & Lokasi" as UC3
  }
  
  package "Modul Booking" {
    usecase "Memesan Jasa (Jadwal & Tarif)" as UC4
    usecase "Menerima Pesanan (Matching)" as UC5
  }
  
  package "Modul Payment" {
    usecase "Melakukan Pembayaran" as UC6
    usecase "Memilih Metode (QRIS/E-Wallet/Cash)" as UC7
  }
  
  package "Modul Notification" {
    usecase "Melacak Maps Petugas" as UC8
    usecase "Kirim Notifikasi (Bayar/Selesai)" as UC9
  }
}

' Relasi Registration
Mahasiswa --> UC1
UC1 ..> UC2 : <<include>>
Mahasiswa --> UC3

' Relasi Booking
Mahasiswa --> UC4
Petugas --> UC5

' Relasi Payment
Mahasiswa --> UC6
UC6 ..> UC7 : <<include>>

' Relasi Notification
UC8 ..> UC4 : <<extend>> 
Petugas --> UC8
Admin --> UC9
UC4 ..> UC9 : <<include>>
UC6 ..> UC9 : <<include>>

@enduml
