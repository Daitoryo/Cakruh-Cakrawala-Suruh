@startuml
actor Mahasiswa
participant "UI Aplikasi" as UI
participant "Modul Booking" as Booking
participant "Modul Notification" as Notif

Mahasiswa -> UI : Pilih kategori jasa, masalah, lokasi, jadwal & tarif
activate UI
UI -> Booking : prosesPemesanan(data_booking)
activate Booking

alt Petugas tersedia (Matching Sukses)
    Booking --> UI : Status: "Menunggu Petugas"
    Booking -> Notif : picuNotifikasi(pesanan_berhasil)
    activate Notif
    Notif --> Booking : status_terkirim
    deactivate Notif
    UI --> Mahasiswa : Tampilkan detail pesanan & profil petugas
else Petugas tidak tersedia
    Booking --> UI : Error: "Gagal Matching"
    UI --> Mahasiswa : Tampilkan pesan "Petugas tidak tersedia di jadwal tersebut"
end

deactivate Booking
deactivate UI
@enduml
